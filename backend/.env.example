# ==================== 应用基础配置 ====================
SUPPORT_DEBUG=false
SUPPORT_LOG_LEVEL=INFO
SUPPORT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SQLAlchemy 使用 Psycopg 3 异步驱动，真实密码只写入本地 backend/.env。
SUPPORT_DATABASE_URL=postgresql+psycopg://supportdesk:supportdesk_dev@127.0.0.1:5432/supportdesk

# ==================== DeepSeek 模型配置 ====================
# 真实密钥只能写入 backend/.env 或部署平台的密钥管理服务，不能提交到 Git。
SUPPORT_MODEL_NAME=deepseek-v4-flash
SUPPORT_MODEL_API_KEY=
SUPPORT_MODEL_BASE_URL=https://api.deepseek.com

# 模型输入裁剪不删除数据库历史；40 条包括用户、AI 和工具消息，并非 40 轮对话。
# Token 为近似预算，预留量用于工具定义等额外开销；当前完整轮次超预算时明确报错。
SUPPORT_CONTEXT_WINDOW__MAX_MESSAGES=40
SUPPORT_CONTEXT_WINDOW__MAX_TOKENS=12000
SUPPORT_CONTEXT_WINDOW__RESERVE_TOKENS=2048
SUPPORT_CONTEXT_WINDOW__CHARS_PER_TOKEN=2.0

# ==================== LangSmith 可观测性配置 ====================
# 填写 API Key 后再启用追踪，避免未授权请求和无意义的告警。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportdesk-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# API Key 关联多个 Workspace 时才需要填写。
LANGSMITH_WORKSPACE_ID=

# ==================== 双端账号 Cookie ====================
# 客户与员工分别在页面注册和登录，不再配置共享企业口令。
# 为对应旧 .env 中的同名字段而保留空占位；后端已不读取，不能作为登录凭据。
# 新部署可以删除下面这个旧字段，不要把历史口令复制到模板。
SUPPORT_STAFF_ACCESS_KEY=
# 本地 HTTP 使用 false；HTTPS 部署必须启用 Secure Cookie。
SUPPORT_COOKIE_SECURE=false

# ==================== 企业知识库 RAG ====================
# Embedding 不是聊天模型。请填写供应商的兼容接口地址、模型名称及实际输出维度。
# 未配置时保持关闭；点击“建立索引并发布”会将该文档发送给此供应商并产生其 API 费用。
SUPPORT_KNOWLEDGE_ENABLED=false
SUPPORT_EMBEDDING_API_KEY=
SUPPORT_EMBEDDING_BASE_URL=
SUPPORT_EMBEDDING_MODEL=
SUPPORT_EMBEDDING_DIMENSIONS=1536
# 余弦相似度阈值需结合企业测试问题调优；不是回答正确率。
SUPPORT_KNOWLEDGE_MIN_SCORE=0.5

# ==================== Neo4j 知识图谱 ====================
# 启用后由后端自动发布版本化的领域知识包；不抽取文档、不复制业务表，不改变现有 RAG 回答。
# 请先自行安装依赖并准备镜像，再启用；scripts/start.sh 会启动并检查 Neo4j。
# 以下开关、地址和账号即使在本地 .env 中遗漏也有默认值；建议显式配置以便核对。
SUPPORT_GRAPH_ENABLED=false
SUPPORT_NEO4J_URI=bolt://127.0.0.1:7687
SUPPORT_NEO4J_USERNAME=neo4j
# 首次初始化至少 8 位；模板始终为空，真实密码只填在 backend/.env。
# 密码含特殊字符时使用单引号；已有数据卷不能通过修改此处来修改库内密码。
SUPPORT_NEO4J_PASSWORD=''
SUPPORT_NEO4J_DATABASE=neo4j
SUPPORT_GRAPH_TIMEOUT_SECONDS=10
