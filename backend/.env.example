# ==================== 应用基础配置 ====================
SUPPORT_DEBUG=false
SUPPORT_CORS_ORIGINS=["http://localhost:3000"]

# ==================== DeepSeek 模型配置 ====================
# 真实密钥只能写入 backend/.env 或部署平台的密钥管理服务，不能提交到 Git。
SUPPORT_MODEL_NAME=deepseek-v4-flash
SUPPORT_MODEL_API_KEY=
SUPPORT_MODEL_BASE_URL=https://api.deepseek.com

# ==================== LangSmith 可观测性配置 ====================
# 填写 API Key 后再启用追踪，避免未授权请求和无意义的告警。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportdesk-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# API Key 关联多个 Workspace 时才需要填写。
LANGSMITH_WORKSPACE_ID=
